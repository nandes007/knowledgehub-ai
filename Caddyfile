{$DOMAIN} {
	encode gzip

	# Backend owns these paths (see backend/app/main.py + routers/); everything
	# else falls through to the Next.js frontend below.
	@backend path /healthz /auth/* /chat /conversations /conversations/* /documents /documents/*
	handle @backend {
		# flush_interval -1: stream every write immediately instead of buffering.
		# Required for /chat's SSE response - without it Caddy waits to fill a
		# buffer before forwarding tokens, so the client never sees a stream.
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
