# Copy to vault.yml, fill in, then encrypt:
#   cp vault.yml.example vault.yml && $EDITOR vault.yml
#   ansible-vault encrypt vault.yml
# Run plays with --ask-vault-pass.

# Supabase DIRECT connection (not the pooler - the pooler is IPv4-only).
# Note the +psycopg driver and sslmode=require.
supabase_db_url: "postgresql+psycopg://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require"

# Password for db_user (postgres.yml) - the one login for every database on
# the server, this project's included.
#   openssl rand -hex 24
postgres_password: "CHANGEME"

openai_api_key: "sk-..."
# Optional: run vision OCR through OpenRouter instead of OpenAI.
# vision_base_url: "https://openrouter.ai/api/v1"
# vision_model: "google/gemini-3.1-flash-lite"
# vision_api_key: "sk-or-..."

# Reusable auth key for tailscale.yml, from
# https://login.tailscale.com/admin/settings/keys
tailscale_authkey: "tskey-auth-..."

# openssl rand -hex 32  - do not reuse the dev value.
jwt_secret: "CHANGEME"

# IAM user knowledgehub-backend - access key limited to s3_bucket/knowledgehub/*.
aws_access_key_id: "AKIA..."
aws_secret_access_key: "CHANGEME"

# Optional: who may sign up and how much one company may use. Left out, signup
# is "approval" and every cap is 0 (unlimited).
# signup_mode: "closed"            # open | approval | closed
# max_documents_per_company: 0
# max_messages_per_company_per_day: 0
# max_companies_per_user: 0

# Qdrant API key for qdrant.yml.
#   openssl rand -hex 32
qdrant_api_key: "CHANGEME"
