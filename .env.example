# --- Database ---
# Used for local (non-Docker) dev. Under `docker compose up`, the backend
# service overrides DATABASE_URL/QDRANT_PATH/UPLOAD_DIR itself to
# point at the `postgres` service and its named volumes - these three
# values here have no effect in that case.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledgehub

# --- Vector store (Qdrant) ---
# Empty QDRANT_URL = embedded Qdrant in QDRANT_PATH, no server needed.
# QDRANT_PATH is relative to the backend process cwd (i.e. `backend/`).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./.qdrant

# --- File storage (local disk volume for v1) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
# Set S3_BUCKET to store uploads in S3 instead of UPLOAD_DIR.
S3_BUCKET=
S3_PREFIX=knowledgehub/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM provider (kept behind services/llm.py so it's swappable) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# OCR for scanned PDFs and images. Empty VISION_BASE_URL uses OpenAI with OPENAI_API_KEY.
# OpenRouter example: VISION_BASE_URL=https://openrouter.ai/api/v1, VISION_MODEL=google/gemini-3.1-flash-lite
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=
VISION_API_KEY=

# --- Retrieval ---
# false = dense-only vector search (the fallback); true = dense + BM25 merged by RRF
HYBRID_SEARCH=true

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
