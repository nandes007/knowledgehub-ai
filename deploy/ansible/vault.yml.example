# Copy to vault.yml, fill in, then encrypt:
#   cp vault.yml.example vault.yml && $EDITOR vault.yml
#   ansible-vault encrypt vault.yml
# Run plays with --ask-vault-pass.

# Supabase DIRECT connection (not the pooler - the pooler is IPv4-only).
# Note the +psycopg driver and sslmode=require.
supabase_db_url: "postgresql+psycopg://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require"

# Password for db_user (postgres.yml) - the one login for every database on
# the server, this project's included.
#   openssl rand -hex 24
postgres_password: "CHANGEME"

openai_api_key: "sk-..."

# Reusable auth key for tailscale.yml, from
# https://login.tailscale.com/admin/settings/keys
tailscale_authkey: "tskey-auth-..."

# openssl rand -hex 32  - do not reuse the dev value.
jwt_secret: "CHANGEME"
