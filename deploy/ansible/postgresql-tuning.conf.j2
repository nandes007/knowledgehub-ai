{# Managed by Ansible - deploy/ansible/postgres.yml #}
# Loaded last via postgresql.conf's `include_dir = 'conf.d'`, so these win
# over the packaged defaults without editing the packaged file.

# The app reaches the database over the host's loopback (its container uses
# host networking). Nothing off-box connects, so never bind a public address.
listen_addresses = 'localhost'
password_encryption = scram-sha-256

# Sized from this host's RAM ({{ ansible_facts['memtotal_mb'] }} MB). Lower than
# the standalone rule of thumb (25% / 75%) because the app containers, Chroma
# and nginx share this box - the usual numbers would push it into swap.
# ponytail: static at provision time - re-run the playbook after a resize.
shared_buffers = {{ (ansible_facts['memtotal_mb'] * 0.15) | int }}MB
effective_cache_size = {{ (ansible_facts['memtotal_mb'] * 0.5) | int }}MB
maintenance_work_mem = {{ [(ansible_facts['memtotal_mb'] * 0.05) | int, 256] | min }}MB
work_mem = 8MB

# SSD-backed volume: a random read costs about the same as a sequential one,
# so the default 4.0 pushes the planner away from indexes it should use.
random_page_cost = 1.1

# Enough to diagnose a slow endpoint without logging every SELECT.
log_min_duration_statement = 1000
log_line_prefix = '%m [%p] %q%u@%d '
log_checkpoints = on
log_autovacuum_min_duration = 10s
