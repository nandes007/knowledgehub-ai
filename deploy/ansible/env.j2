# Managed by Ansible - edit deploy/vault.yml, not this file.

# --- Database ---
{% if use_local_postgres | bool %}
DATABASE_URL=postgresql+psycopg://{{ db_user }}:{{ postgres_password | urlencode }}@127.0.0.1:5432/{{ db_name }}
{% else %}
DATABASE_URL={{ supabase_db_url }}
{% endif %}

# --- Storage (compose overrides these to container paths; kept for parity) ---
CHROMA_PERSIST_DIR=/data/chroma
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY={{ openai_api_key }}
# Never change after documents are ingested - existing Chroma vectors become unusable.
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# --- Auth ---
JWT_SECRET={{ jwt_secret }}
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
CORS_ORIGINS=https://{{ domain }}

# --- Frontend (baked into the JS bundle at build time) ---
NEXT_PUBLIC_API_URL=https://{{ domain }}/api
